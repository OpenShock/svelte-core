{
	"name": "@openshock/svelte-core",
	"version": "0.3.0",
	"description": "Shared OpenShock Svelte/SvelteKit core: shadcn-svelte component baseline, design-system theme, and common utilities used by both the cloud frontend and the firmware captive portal.",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenShock/svelte-core.git"
	},
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite dev",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && eslint .",
		"lint:package": "publint --strict",
		"format": "prettier --write .",
		"update-shadcn": "node scripts/update-shadcn.js",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"src/lib",
		"!src/lib/**/*.test.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./theme.css": "./src/lib/theme.css",
		"./package.json": "./package.json",
		"./components": "./src/lib/components/index.ts",
		"./components/datetime-picker": "./src/lib/components/datetime-picker/index.ts",
		"./components/dialog-manager": "./src/lib/components/dialog-manager/index.ts",
		"./components/input": "./src/lib/components/input/index.ts",
		"./components/metadata": "./src/lib/components/metadata/index.ts",
		"./components/metadata/Twitter": "./src/lib/components/metadata/Twitter/index.ts",
		"./components/stepper": "./src/lib/components/stepper/index.ts",
		"./components/svg": "./src/lib/components/svg/index.ts",
		"./components/ui/accordion": "./src/lib/components/ui/accordion/index.ts",
		"./components/ui/avatar": "./src/lib/components/ui/avatar/index.ts",
		"./components/ui/badge": "./src/lib/components/ui/badge/index.ts",
		"./components/ui/breadcrumb": "./src/lib/components/ui/breadcrumb/index.ts",
		"./components/ui/button": "./src/lib/components/ui/button/index.ts",
		"./components/ui/calendar": "./src/lib/components/ui/calendar/index.ts",
		"./components/ui/card": "./src/lib/components/ui/card/index.ts",
		"./components/ui/checkbox": "./src/lib/components/ui/checkbox/index.ts",
		"./components/ui/collapsible": "./src/lib/components/ui/collapsible/index.ts",
		"./components/ui/command": "./src/lib/components/ui/command/index.ts",
		"./components/ui/dialog": "./src/lib/components/ui/dialog/index.ts",
		"./components/ui/drawer": "./src/lib/components/ui/drawer/index.ts",
		"./components/ui/dropdown-menu": "./src/lib/components/ui/dropdown-menu/index.ts",
		"./components/ui/empty": "./src/lib/components/ui/empty/index.ts",
		"./components/ui/field": "./src/lib/components/ui/field/index.ts",
		"./components/ui/form": "./src/lib/components/ui/form/index.ts",
		"./components/ui/input": "./src/lib/components/ui/input/index.ts",
		"./components/ui/input-group": "./src/lib/components/ui/input-group/index.ts",
		"./components/ui/label": "./src/lib/components/ui/label/index.ts",
		"./components/ui/menubar": "./src/lib/components/ui/menubar/index.ts",
		"./components/ui/pagination": "./src/lib/components/ui/pagination/index.ts",
		"./components/ui/popover": "./src/lib/components/ui/popover/index.ts",
		"./components/ui/progress": "./src/lib/components/ui/progress/index.ts",
		"./components/ui/range-calendar": "./src/lib/components/ui/range-calendar/index.ts",
		"./components/ui/scroll-area": "./src/lib/components/ui/scroll-area/index.ts",
		"./components/ui/select": "./src/lib/components/ui/select/index.ts",
		"./components/ui/separator": "./src/lib/components/ui/separator/index.ts",
		"./components/ui/sheet": "./src/lib/components/ui/sheet/index.ts",
		"./components/ui/sidebar": "./src/lib/components/ui/sidebar/index.ts",
		"./components/ui/skeleton": "./src/lib/components/ui/skeleton/index.ts",
		"./components/ui/slider": "./src/lib/components/ui/slider/index.ts",
		"./components/ui/sonner": "./src/lib/components/ui/sonner/index.ts",
		"./components/ui/spinner": "./src/lib/components/ui/spinner/index.ts",
		"./components/ui/switch": "./src/lib/components/ui/switch/index.ts",
		"./components/ui/table": "./src/lib/components/ui/table/index.ts",
		"./components/ui/tabs": "./src/lib/components/ui/tabs/index.ts",
		"./components/ui/textarea": "./src/lib/components/ui/textarea/index.ts",
		"./components/ui/toggle": "./src/lib/components/ui/toggle/index.ts",
		"./components/ui/toggle-group": "./src/lib/components/ui/toggle-group/index.ts",
		"./components/ui/tooltip": "./src/lib/components/ui/tooltip/index.ts",
		"./hooks": "./src/lib/hooks/index.ts",
		"./inputvalidation": "./src/lib/inputvalidation/index.ts",
		"./typeguards": "./src/lib/typeguards/index.ts",
		"./types": "./src/lib/types/index.ts",
		"./utils": "./src/lib/utils/index.ts",
		"./*": "./src/lib/*"
	},
	"peerDependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.21.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"svelte": "^5.56.1",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"temporal-polyfill": "^1.0.1",
		"vaul-svelte": "1.0.0-next.7"
	},
	"peerDependenciesMeta": {
		"@internationalized/date": {
			"optional": true
		},
		"formsnap": {
			"optional": true
		},
		"svelte-sonner": {
			"optional": true
		},
		"sveltekit-superforms": {
			"optional": true
		},
		"temporal-polyfill": {
			"optional": true
		},
		"vaul-svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@typescript/native": "npm:typescript@~7.0.2",
		"bits-ui": "2.18.1",
		"clsx": "^2.1.1",
		"eslint": "^10.8.1",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"prettier": "~3.9.6",
		"prettier-plugin-organize-imports": "~4.3.0",
		"prettier-plugin-svelte": "~4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.23",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"temporal-polyfill": "^1.0.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"shadcn-svelte",
		"openshock",
		"component-library"
	]
}
